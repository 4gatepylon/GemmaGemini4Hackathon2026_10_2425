{
  "name": "decoder decode token",
  "description": "One decode token through LAYERS Llama-3.2-1B-shaped layers (dim 2048, ffn 8192, 32 q / 8 kv heads), attending over POS+1 cached keys. Per-layer weights are rotated, so each layer streams cold weights like the real model (~2 GB per token at LAYERS=16).",
  "source": "decoder.metal",
  "defines": {"NR": 4, "NSG": 8, "ATT_NSG": 8},
  "vars": {
    "LAYERS": 16, "D": 2048, "F": 8192, "NH": 32, "NKV": 8, "HD": 64, "CTX": 4096, "POS": 511,
    "QKV": "(NH + 2 * NKV) * HD"
  },
  "loop": {"name": "layer", "count": "LAYERS"},
  "whole": true,
  "buffers": {
    "x":   {"type": "float", "count": "D", "init": "random"},
    "xn":  {"type": "float", "count": "D"},
    "qkv": {"type": "float", "count": "QKV"},
    "att": {"type": "float", "count": "D"},
    "hid": {"type": "float", "count": "F"},
    "attn_norm": {"type": "float", "count": "D", "init": "ones", "rotate": "LAYERS"},
    "ffn_norm":  {"type": "float", "count": "D", "init": "ones", "rotate": "LAYERS"},
    "wqkv": {"type": "half", "count": "QKV * D", "init": {"random": [-0.02, 0.02]}, "rotate": "LAYERS"},
    "wo":   {"type": "half", "count": "D * D",   "init": {"random": [-0.02, 0.02]}, "rotate": "LAYERS"},
    "wg":   {"type": "half", "count": "F * D",   "init": {"random": [-0.02, 0.02]}, "rotate": "LAYERS"},
    "wu":   {"type": "half", "count": "F * D",   "init": {"random": [-0.02, 0.02]}, "rotate": "LAYERS"},
    "wd":   {"type": "half", "count": "D * F",   "init": {"random": [-0.02, 0.02]}, "rotate": "LAYERS"},
    "kcache": {"type": "half", "count": "NKV * CTX * HD", "init": {"random": [-1, 1]}, "rotate": "LAYERS"},
    "vcache": {"type": "half", "count": "NKV * CTX * HD", "init": {"random": [-1, 1]}, "rotate": "LAYERS"}
  },
  "steps": [
    {"name": "attn_norm", "group": "attention", "kernel": "rmsnorm",
     "bind": [{"buf": "x"}, {"buf": "attn_norm"}, {"buf": "xn"}, {"u32": "D"}, {"f32": 1e-5}],
     "threadgroups": [1], "threads": [256], "bytes": "D * 12"},
    {"name": "qkv", "group": "attention", "kernel": "matvec_f16",
     "bind": [{"buf": "wqkv"}, {"buf": "xn"}, {"buf": "qkv"}, {"u32": "QKV"}, {"u32": "D"}],
     "threadgroups": ["QKV / (NR * NSG)"], "threads": ["32 * NSG"],
     "bytes": "QKV * D * 2 + D * 4 + QKV * 4", "flops": "2 * QKV * D"},
    {"name": "rope_kv", "group": "attention", "kernel": "rope_kv",
     "bind": [{"buf": "qkv"}, {"buf": "kcache"}, {"buf": "vcache"},
              {"struct": [{"u32": "NH"}, {"u32": "NKV"}, {"u32": "CTX"}, {"u32": "POS"}]}],
     "grid": ["HD / 2", "NH + NKV"], "threads": ["HD / 2", 4], "bytes": "QKV * 8"},
    {"name": "attention", "group": "attention", "kernel": "attention",
     "bind": [{"buf": "qkv"}, {"buf": "kcache"}, {"buf": "vcache"}, {"buf": "att"},
              {"struct": [{"u32": "NH"}, {"u32": "NKV"}, {"u32": "CTX"}, {"u32": "POS"}, {"f32": "1 / pow(HD, 0.5)"}]}],
     "threadgroup_memory": ["ceildiv((POS + 1) * 4, 16) * 16"],
     "threadgroups": ["NH"], "threads": ["32 * ATT_NSG"],
     "bytes": "2 * NKV * (POS + 1) * HD * 2 + NH * HD * 8", "flops": "4 * NH * HD * (POS + 1)"},
    {"name": "wo", "group": "attention", "kernel": "matvec_f16_add",
     "bind": [{"buf": "wo"}, {"buf": "att"}, {"buf": "x"}, {"u32": "D"}, {"u32": "D"}],
     "threadgroups": ["D / (NR * NSG)"], "threads": ["32 * NSG"],
     "bytes": "D * D * 2 + D * 12", "flops": "2 * D * D"},
    {"name": "ffn_norm", "group": "mlp", "kernel": "rmsnorm",
     "bind": [{"buf": "x"}, {"buf": "ffn_norm"}, {"buf": "xn"}, {"u32": "D"}, {"f32": 1e-5}],
     "threadgroups": [1], "threads": [256], "bytes": "D * 12"},
    {"name": "gate_up", "group": "mlp", "kernel": "gate_up_silu",
     "bind": [{"buf": "wg"}, {"buf": "wu"}, {"buf": "xn"}, {"buf": "hid"}, {"u32": "F"}, {"u32": "D"}],
     "threadgroups": ["F / (NR * NSG)"], "threads": ["32 * NSG"],
     "bytes": "2 * F * D * 2 + D * 4 + F * 4", "flops": "4 * F * D"},
    {"name": "down", "group": "mlp", "kernel": "matvec_f16_add",
     "bind": [{"buf": "wd"}, {"buf": "hid"}, {"buf": "x"}, {"u32": "D"}, {"u32": "F"}],
     "threadgroups": ["D / (NR * NSG)"], "threads": ["32 * NSG"],
     "bytes": "D * F * 2 + F * 4 + D * 8", "flops": "2 * D * F"}
  ],
  "warmup": 3,
  "reps": 10
}
