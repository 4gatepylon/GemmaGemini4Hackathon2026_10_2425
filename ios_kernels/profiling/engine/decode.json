{
  "name": "engine decode token",
  "description": "One decode token of the Llama-3.2-1B Metal engine, replayed with the engine's own kernels.metal (pass --source; profile_engine.py does) and its dispatch geometry and default tunables: embed, 16 layers, final norm, LM head, argmax. Weights are random and rotated per layer (cold, like the real model); POS is the token's position (tg128 from an empty cache averages 64).",
  "source": "kernels.metal",
  "defines": {"MV_NSG": 8, "MV_NR": 4, "HEAD_DIM": 64, "ATT_NSG": 8, "GEMM_BM": 64, "GEMM_BN": 64},
  "vars": {
    "LAYERS": 16, "D": 2048, "F": 8192, "NH": 32, "NKV": 8, "HD": 64, "V": 128256, "CTX": 4096, "POS": 64,
    "QKV": "(NH + 2 * NKV) * HD", "ROWS": "MV_NSG * MV_NR"
  },
  "loop": {"name": "layer", "count": "LAYERS"},
  "whole": true,
  "buffers": {
    "E":      {"type": "half",  "count": "V * D", "init": {"random": [-0.02, 0.02]}},
    "tokens": {"type": "int",   "count": "CTX + 1", "init": {"random_int": [0, 128256]}},
    "x":      {"type": "float", "count": "D", "init": "random"},
    "xn":     {"type": "float", "count": "D"},
    "qkv":    {"type": "float", "count": "QKV"},
    "att":    {"type": "float", "count": "D"},
    "hid":    {"type": "float", "count": "F"},
    "logits": {"type": "float", "count": "V"},
    "inv_freq":   {"type": "float", "count": "HD / 2", "init": {"random": [0.0001, 1]}},
    "final_norm": {"type": "float", "count": "D", "init": "ones"},
    "attn_norm":  {"type": "float", "count": "D", "init": "ones", "rotate": "LAYERS"},
    "ffn_norm":   {"type": "float", "count": "D", "init": "ones", "rotate": "LAYERS"},
    "wqkv":   {"type": "half", "count": "QKV * D", "init": {"random": [-0.02, 0.02]}, "rotate": "LAYERS"},
    "wo":     {"type": "half", "count": "D * D",   "init": {"random": [-0.02, 0.02]}, "rotate": "LAYERS"},
    "wgate":  {"type": "half", "count": "F * D",   "init": {"random": [-0.02, 0.02]}, "rotate": "LAYERS"},
    "wup":    {"type": "half", "count": "F * D",   "init": {"random": [-0.02, 0.02]}, "rotate": "LAYERS"},
    "wdown":  {"type": "half", "count": "D * F",   "init": {"random": [-0.02, 0.02]}, "rotate": "LAYERS"},
    "kcache": {"type": "half", "count": "NKV * CTX * HD", "init": {"random": [-1, 1]}, "rotate": "LAYERS"},
    "vcache": {"type": "half", "count": "NKV * CTX * HD", "init": {"random": [-1, 1]}, "rotate": "LAYERS"}
  },
  "steps": [
    {"name": "embed", "phase": "pre", "kernel": "embed",
     "bind": [{"buf": "E"}, {"buf": "tokens"}, {"buf": "x"}, {"u32": "POS"}, {"u32": "D"}],
     "grid": ["D"], "threads": [256], "bytes": "D * 6"},
    {"name": "attn_norm", "group": "attention", "kernel": "rmsnorm_f32",
     "bind": [{"buf": "x"}, {"buf": "attn_norm"}, {"buf": "xn"}, {"u32": "D"}, {"f32": 1e-5}],
     "threadgroups": [1], "threads": [256], "bytes": "D * 12"},
    {"name": "qkv", "group": "attention", "kernel": "matvec_f16",
     "bind": [{"buf": "wqkv"}, {"buf": "xn"}, {"buf": "qkv"}, {"u32": "QKV"}, {"u32": "D"}],
     "threadgroups": ["QKV / ROWS"], "threads": ["32 * MV_NSG"],
     "bytes": "QKV * D * 2 + D * 4 + QKV * 4", "flops": "2 * QKV * D"},
    {"name": "rope_kv", "group": "attention", "kernel": "rope_kv",
     "bind": [{"buf": "qkv"}, {"buf": "kcache"}, {"buf": "vcache"}, {"buf": "inv_freq"},
              {"struct": [{"u32": "NH"}, {"u32": "NKV"}, {"u32": "CTX"}, {"u32": "POS"}]}],
     "grid": ["HD / 2", "NH + NKV", 1], "threads": ["HD / 2", 4, 1], "bytes": "QKV * 8"},
    {"name": "attention", "group": "attention", "kernel": "attention",
     "bind": [{"buf": "qkv"}, {"buf": "kcache"}, {"buf": "vcache"}, {"buf": "att"},
              {"struct": [{"u32": "NH"}, {"u32": "NKV"}, {"u32": "CTX"}, {"u32": "POS"}, {"u32": "QKV"}, {"u32": "D"},
                          {"f32": "1 / pow(HD, 0.5)"}]}],
     "threadgroup_memory": ["ceildiv((POS + 1) * 4, 16) * 16"],
     "threadgroups": ["NH", 1], "threads": ["32 * ATT_NSG"],
     "bytes": "2 * NKV * (POS + 1) * HD * 2 + NH * HD * 8", "flops": "4 * NH * HD * (POS + 1)"},
    {"name": "wo", "group": "attention", "kernel": "matvec_f16_add",
     "bind": [{"buf": "wo"}, {"buf": "att"}, {"buf": "x"}, {"u32": "D"}, {"u32": "D"}],
     "threadgroups": ["D / ROWS"], "threads": ["32 * MV_NSG"],
     "bytes": "D * D * 2 + D * 12", "flops": "2 * D * D"},
    {"name": "ffn_norm", "group": "mlp", "kernel": "rmsnorm_f32",
     "bind": [{"buf": "x"}, {"buf": "ffn_norm"}, {"buf": "xn"}, {"u32": "D"}, {"f32": 1e-5}],
     "threadgroups": [1], "threads": [256], "bytes": "D * 12"},
    {"name": "gate_up", "group": "mlp", "kernel": "matvec_gate_up_silu",
     "bind": [{"buf": "wgate"}, {"buf": "wup"}, {"buf": "xn"}, {"buf": "hid"}, {"u32": "F"}, {"u32": "D"}],
     "threadgroups": ["F / ROWS"], "threads": ["32 * MV_NSG"],
     "bytes": "2 * F * D * 2 + D * 4 + F * 4", "flops": "4 * F * D"},
    {"name": "down", "group": "mlp", "kernel": "matvec_f16_add",
     "bind": [{"buf": "wdown"}, {"buf": "hid"}, {"buf": "x"}, {"u32": "D"}, {"u32": "F"}],
     "threadgroups": ["D / ROWS"], "threads": ["32 * MV_NSG"],
     "bytes": "D * F * 2 + F * 4 + D * 8", "flops": "2 * D * F"},
    {"name": "final_norm", "phase": "post", "kernel": "rmsnorm_f32",
     "bind": [{"buf": "x"}, {"buf": "final_norm"}, {"buf": "xn"}, {"u32": "D"}, {"f32": 1e-5}],
     "threadgroups": [1], "threads": [256], "bytes": "D * 12"},
    {"name": "lm_head", "phase": "post", "kernel": "matvec_f16",
     "bind": [{"buf": "E"}, {"buf": "xn"}, {"buf": "logits"}, {"u32": "V"}, {"u32": "D"}],
     "threadgroups": ["V / ROWS"], "threads": ["32 * MV_NSG"],
     "bytes": "V * D * 2 + D * 4 + V * 4", "flops": "2 * V * D"},
    {"name": "argmax", "phase": "post", "kernel": "argmax",
     "bind": [{"buf": "logits"}, {"buf": "tokens"}, {"u32": "V"}, {"u32": "POS + 1"}],
     "threadgroups": [1], "threads": [1024], "bytes": "V * 4"}
  ],
  "warmup": 3,
  "reps": 10
}
