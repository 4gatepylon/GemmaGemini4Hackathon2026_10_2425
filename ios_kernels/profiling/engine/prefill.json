{
  "name": "engine prefill chunk",
  "description": "One prompt chunk (T tokens, from an empty cache) of the Llama-3.2-1B Metal engine, replayed with the engine's own kernels.metal (pass --source; profile_engine.py does) and its dispatch geometry: embed rows, 16 layers on the simdgroup GEMM path, final norm of the last row, LM head, argmax. T=512 matches pp512.",
  "source": "kernels.metal",
  "defines": {"MV_NSG": 8, "MV_NR": 4, "HEAD_DIM": 64, "ATT_NSG": 8, "GEMM_BM": 64, "GEMM_BN": 64},
  "vars": {
    "LAYERS": 16, "D": 2048, "F": 8192, "NH": 32, "NKV": 8, "HD": 64, "V": 128256, "CTX": 4096, "T": 512, "POS0": 0,
    "QKV": "(NH + 2 * NKV) * HD", "ROWS": "MV_NSG * MV_NR", "TP": "ceildiv(T, GEMM_BM) * GEMM_BM"
  },
  "loop": {"name": "layer", "count": "LAYERS"},
  "whole": true,
  "reps": 5,
  "warmup": 2,
  "buffers": {
    "E":        {"type": "half",  "count": "V * D", "init": {"random": [-0.02, 0.02]}},
    "tokens":   {"type": "int",   "count": "TP + 1", "init": {"random_int": [0, 128256]}},
    "x":        {"type": "float", "count": "TP * D", "init": "random"},
    "xn_half":  {"type": "half",  "count": "TP * D"},
    "qkv":      {"type": "float", "count": "TP * QKV"},
    "att":      {"type": "float", "count": "TP * D"},
    "att_half": {"type": "half",  "count": "TP * D"},
    "hid_half": {"type": "half",  "count": "TP * F"},
    "xn":       {"type": "float", "count": "D"},
    "logits":   {"type": "float", "count": "V"},
    "inv_freq":   {"type": "float", "count": "HD / 2", "init": {"random": [0.0001, 1]}},
    "final_norm": {"type": "float", "count": "D", "init": "ones"},
    "attn_norm":  {"type": "float", "count": "D", "init": "ones", "rotate": "LAYERS"},
    "ffn_norm":   {"type": "float", "count": "D", "init": "ones", "rotate": "LAYERS"},
    "wqkv":   {"type": "half", "count": "QKV * D", "init": {"random": [-0.02, 0.02]}, "rotate": "LAYERS"},
    "wo":     {"type": "half", "count": "D * D",   "init": {"random": [-0.02, 0.02]}, "rotate": "LAYERS"},
    "wgate":  {"type": "half", "count": "F * D",   "init": {"random": [-0.02, 0.02]}, "rotate": "LAYERS"},
    "wup":    {"type": "half", "count": "F * D",   "init": {"random": [-0.02, 0.02]}, "rotate": "LAYERS"},
    "wdown":  {"type": "half", "count": "D * F",   "init": {"random": [-0.02, 0.02]}, "rotate": "LAYERS"},
    "kcache": {"type": "half", "count": "NKV * CTX * HD", "rotate": "LAYERS"},
    "vcache": {"type": "half", "count": "NKV * CTX * HD", "rotate": "LAYERS"}
  },
  "steps": [
    {"name": "embed", "phase": "pre", "kernel": "embed_rows",
     "bind": [{"buf": "E"}, {"buf": "tokens"}, {"buf": "x"}, {"u32": "D"}],
     "grid": ["D", "T"], "threads": [256, 1], "bytes": "T * D * 6"},
    {"name": "attn_norm", "group": "attention", "kernel": "rmsnorm_f16",
     "bind": [{"buf": "x"}, {"buf": "attn_norm"}, {"buf": "xn_half"}, {"u32": "D"}, {"f32": 1e-5}],
     "threadgroups": ["T"], "threads": [256], "bytes": "T * D * 6 + D * 4"},
    {"name": "qkv", "group": "attention", "kernel": "gemm_f16",
     "bind": [{"buf": "wqkv"}, {"buf": "xn_half"}, {"buf": "qkv"}, {"u32": "T"}, {"u32": "QKV"}, {"u32": "D"}],
     "threadgroups": ["QKV / GEMM_BN", "ceildiv(T, GEMM_BM)"], "threads": [128],
     "bytes": "QKV * D * 2 + T * D * 2 + T * QKV * 4", "flops": "2 * T * QKV * D"},
    {"name": "rope_kv", "group": "attention", "kernel": "rope_kv",
     "bind": [{"buf": "qkv"}, {"buf": "kcache"}, {"buf": "vcache"}, {"buf": "inv_freq"},
              {"struct": [{"u32": "NH"}, {"u32": "NKV"}, {"u32": "CTX"}, {"u32": "POS0"}]}],
     "grid": ["HD / 2", "NH + NKV", "T"], "threads": ["HD / 2", 4, 1], "bytes": "T * QKV * 8"},
    {"name": "attention", "group": "attention", "kernel": "attention",
     "bind": [{"buf": "qkv"}, {"buf": "kcache"}, {"buf": "vcache"}, {"buf": "att"},
              {"struct": [{"u32": "NH"}, {"u32": "NKV"}, {"u32": "CTX"}, {"u32": "POS0"}, {"u32": "QKV"}, {"u32": "D"},
                          {"f32": "1 / pow(HD, 0.5)"}]}],
     "threadgroup_memory": ["ceildiv((POS0 + T) * 4, 16) * 16"],
     "threadgroups": ["NH", "T"], "threads": ["32 * ATT_NSG"],
     "bytes": "2 * NKV * (POS0 + T) * HD * 2 + T * NH * HD * 8", "flops": "2 * NH * HD * T * (2 * POS0 + T + 1)"},
    {"name": "to_half", "group": "attention", "kernel": "f32_to_f16",
     "bind": [{"buf": "att"}, {"buf": "att_half"}],
     "grid": ["T * D"], "threads": [256], "bytes": "T * D * 6"},
    {"name": "wo", "group": "attention", "kernel": "gemm_f16_add",
     "bind": [{"buf": "wo"}, {"buf": "att_half"}, {"buf": "x"}, {"u32": "T"}, {"u32": "D"}, {"u32": "D"}],
     "threadgroups": ["D / GEMM_BN", "ceildiv(T, GEMM_BM)"], "threads": [128],
     "bytes": "D * D * 2 + T * D * 10", "flops": "2 * T * D * D"},
    {"name": "ffn_norm", "group": "mlp", "kernel": "rmsnorm_f16",
     "bind": [{"buf": "x"}, {"buf": "ffn_norm"}, {"buf": "xn_half"}, {"u32": "D"}, {"f32": 1e-5}],
     "threadgroups": ["T"], "threads": [256], "bytes": "T * D * 6 + D * 4"},
    {"name": "gate_up", "group": "mlp", "kernel": "gemm_gate_up_silu",
     "bind": [{"buf": "wgate"}, {"buf": "wup"}, {"buf": "xn_half"}, {"buf": "hid_half"}, {"u32": "T"}, {"u32": "F"}, {"u32": "D"}],
     "threadgroups": ["F / (GEMM_BN / 2)", "ceildiv(T, GEMM_BM)"], "threads": [128],
     "bytes": "2 * F * D * 2 + T * D * 2 + T * F * 2", "flops": "4 * T * F * D"},
    {"name": "down", "group": "mlp", "kernel": "gemm_f16_add",
     "bind": [{"buf": "wdown"}, {"buf": "hid_half"}, {"buf": "x"}, {"u32": "T"}, {"u32": "D"}, {"u32": "F"}],
     "threadgroups": ["D / GEMM_BN", "ceildiv(T, GEMM_BM)"], "threads": [128],
     "bytes": "D * F * 2 + T * F * 2 + T * D * 8", "flops": "2 * T * D * F"},
    {"name": "final_norm", "phase": "post", "kernel": "rmsnorm_f32",
     "bind": [{"buf": "x", "offset": "(T - 1) * D * 4"}, {"buf": "final_norm"}, {"buf": "xn"}, {"u32": "D"}, {"f32": 1e-5}],
     "threadgroups": [1], "threads": [256], "bytes": "D * 12"},
    {"name": "lm_head", "phase": "post", "kernel": "matvec_f16",
     "bind": [{"buf": "E"}, {"buf": "xn"}, {"buf": "logits"}, {"u32": "V"}, {"u32": "D"}],
     "threadgroups": ["V / ROWS"], "threads": ["32 * MV_NSG"],
     "bytes": "V * D * 2 + D * 4 + V * 4", "flops": "2 * V * D"},
    {"name": "argmax", "phase": "post", "kernel": "argmax",
     "bind": [{"buf": "logits"}, {"buf": "tokens"}, {"u32": "V"}, {"u32": "T"}],
     "threadgroups": [1], "threads": [1024], "bytes": "V * 4"}
  ]
}
